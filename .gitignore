# 环境变量（包含密钥、数据库连接、模型接口等敏感信息）
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store

# 本地 AI 工具配置
.claude/
.codex/
.agents/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/

# Python 测试与类型检查
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / 前端
node_modules/
page/dist/
dist/

# 运行日志
logs/
*.log

# 本地临时文件
tmp/
temp/

# 本地运行期状态（Agent 检查点等，不应入库）
page/agent_state.db

