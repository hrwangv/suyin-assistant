# Session Memory V1（MySQL + Redis）
# 复制到 .env 并按实际环境修改

MYSQL_URL=mysql+pymysql://root:password@127.0.0.1:3306/suyin_memory?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Redis 最近消息缓存容量
MAX_CACHED_MESSAGES=200
# Redis 缓存 TTL，秒
CACHE_TTL_SECONDS=604800

# 每一轮读取多少条最近消息作为上下文（读取上限，与缓存容量无关）
CONTEXT_READ_LIMIT=50
# Query Analyzer 读取历史的 token 预算（超额丢最老的一条）
MAX_TOKEN_WINDOW_SIZE=8000
TOKENIZER_ENCODING=cl100k_base

# Agent Memory L2/L3
MEMORY_QDRANT_COLLECTION=agent_memory
ENTITY_QDRANT_COLLECTION=agent_entity

# 长期记忆归属的默认用户：长期记忆按用户聚合，跨对话共享。
# 留空且请求未带 user_id 时，长期记忆会退化为会话级（新对话读不到）。
MEMORY_DEFAULT_USER_ID=default-user

# 最近消息上下文缓存 TTL（秒）
REDIS_CONTEXT_TTL=86400
# 任务状态缓存 TTL（秒）
REDIS_TASK_TTL=7200
# 实体上下文缓存 TTL（秒）
REDIS_ENTITY_TTL=7200

# Redis 缓存里最多保留多少条最近消息（缓存容量）
CONTEXT_CACHE_CAPACITY=50
# MySQL 兜底表每个会话保留的最近消息条数（建议与上面一致，回源才无损）
CONTEXT_MYSQL_KEEP=50
# 长期记忆抽取时，提供给 LLM 的最近消息条数
EXTRACTION_CONTEXT_MESSAGES=10
# 长期记忆抽取时送给模型的历史上下文 token 预算（超额丢最老的一条）
EXTRACTION_CONTEXT_MAX_TOKENS=4000
# 抽取时作为去重参考的「已有记忆」token 预算（超额丢尾部，防自我放大）
EXTRACTION_EXISTING_MAX_TOKENS=2000

# ---------- 长期记忆抽取的触发控制 ----------
# 距上次抽取新增多少条消息才触发一次（必须小于 CONTEXT_MYSQL_KEEP，给异步执行留余量）
EXTRACT_TRIGGER_NEW_MESSAGES=40
# 最小批量：至少一问一答才值得抽
EXTRACT_MIN_BATCH=2
# 单次批处理上限
EXTRACT_BATCH_LIMIT=60
# 抽取水位的 TTL（秒），默认 7 天
EXTRACT_WATERMARK_TTL=604800

# 强度低于该值时归档
ARCHIVE_STRENGTH_THRESHOLD=0.1
# 强度低于该值但未归档时标记为 WEAK
WEAK_STRENGTH_THRESHOLD=0.3
# 访问次数增益系数
DECAY_ALPHA=0.1

# 实体检索相似度阈值
ENTITY_SEARCH_THRESHOLD=0.5
# 实体命中的最大加分（dense 相似度约 0.35~0.96，建议 0.2 与其同量级）
ENTITY_BOOST_MAX=0.5
# 实体语义去重阈值
ENTITY_DEDUP_THRESHOLD=0.95

# ---------- 召回候选数量 ----------
# 每一路（dense/sparse）预取的候选数
RETRIEVAL_PREFETCH_LIMIT=50
# 单次混合检索返回条数（主路 / HyDE 路各自拿到这么多）
RETRIEVAL_FUSED_LIMIT=20
# 主路 + HyDE 路合并后再融合，保留多少条进 rerank
RETRIEVAL_MERGE_TOP_K=20
# rerank 之后最多保留多少条进回答 prompt
RETRIEVAL_RERANK_MAX_TOPK=12

# ---------- 回答 prompt 的预算 ----------
# 输入总预算（token）。不用模型窗口当预算：真正的约束是成本、首字延迟和长上下文注意力衰减
ANSWER_INPUT_TOKEN_BUDGET=32000
# 给模型回答预留的输出空间（回答常带列表和表格，别留太少）
ANSWER_OUTPUT_RESERVE_TOKENS=3000
# 安全缓冲：吸收 tokenizer 差异（deepseek 与 cl100k 不完全一致）和模板变动
ANSWER_SAFETY_BUFFER_TOKENS=1500
# 长期记忆的检索条数（检索阶段就限住，后面还有总预算兜底）
ANSWER_LONG_TERM_MEMORY_TOP_K=5
# 长期记忆粗召回候选上限
SEMANTIC_INTERNAL_LIMIT=60
# 长期记忆最终返回条数默认值
DEFAULT_TOP_K=10

# 文档切分（document split）
# 单个Chunk最大字符长度（不是token）：超过则触发二次切分（适配大模型上下文窗口）
DOC_SPLIT_MAX_CONTENT_LENGTH=2000
# 短Chunk合并阈值：同父标题的短Chunk会被合并，减少碎片化
DOC_SPLIT_MIN_CONTENT_LENGTH=500

# ======================================================================
# 企业业务智能 Agent（app/agent/）
# 统一入口：POST /api/agent/chat，附件：POST /api/agent/upload
# 关掉 AGENT_ENABLED 后后端行为与改造前完全一致（/query 不受影响）
# ======================================================================
AGENT_ENABLED=true
# Main Agent 使用的模型，留空复用 LLM_MODEL_ID
AGENT_LLM_MODEL_ID=
# 一次请求内 Supervisor 最多决策几次（防止 document → supervisor 打转）
AGENT_MAX_SUPERVISOR_TURNS=5

# ---------- Document Skill ----------
# 只上传询证函、用户又没说做什么时，是否自动提取邮寄地址。
# 留空 = 按规范反问用户；填 extract_mailing_address 则自动执行（强化易拍寄老业务）
AGENT_DEFAULT_INQUIRY_ACTION=
# OCR 只走外部 OCR MCP（无本地兜底），连接信息在 app/agent/mcp/builtin.py
# 文档正文送进大模型的字符上限（分类/抽取/摘要共用）
AGENT_DOCUMENT_MAX_CHARS=12000

# ---------- MCP 服务 ----------
# MCP 的「有哪些服务 / 连哪里 / 传输方式 / 工具名 / 入参形态」全部写在代码里：
#     app/agent/mcp/builtin.py   ← 唯一配置处（对照 Yuxi 的 agents/mcp/builtin.py）
# 本文件（.env）只放密钥；如需临时覆盖地址，可另设 OCR_MCP_BASE_URL / YJT_BASE_URL
# 财汇 MCP（企业信息 + 资讯两个槽位）共用一套凭据：YJT_BASE_URL / YJT_API_KEY
OCR_MCP_API_KEY=
YJT_API_KEY=
YJT_BASE_URL=https://mcp.finchina.com/finchina-data-mcp-server/mcp
# 附件上传到 COS 用的桶（OCR MCP 若只收"图片链接"，附件会先传这里换公网地址）
COS_BUCKET=suyin-assistant-1384284140
# 公网地址有效期（秒）：桶默认私有，必须用签名 URL；过期自动续签，不重传
COS_URL_EXPIRE_SECONDS=600

# ---------- PostgreSQL（Agent 执行记录；检查点也可复用同一条连接串）----------
# 留空 = 不落库（执行记录降级成只写日志，本地开发不用装数据库）
# 方式一：整条连接串（优先）
PG_DSN=
# 方式二：分项配置（PG_DSN 为空时生效）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
# 建表用的 schema，默认 public
PG_SCHEMA=public
# 检查点（State / HITL 断点）存哪：
#   memory                              进程内，重启即丢（默认，单机联调够用）
#   sqlite:output/agent_state.db        单机持久化，重启不丢 ← 本项目采用
# 用 sqlite 时文件会落在项目 output/ 下（已在 .gitignore 里），不需要额外建库建表
AGENT_CHECKPOINT=sqlite:output/agent_state.db

# ---------- Application Skill ----------
# 多候选企业是否需要用户确认（建议保持 true：不允许猜主体）
AGENT_COMPANY_REQUIRE_CONFIRMATION=true
# 单一候选自动选中的最低置信度
AGENT_COMPANY_SEARCH_LIMIT=10
# 生成 DOCX 前是否需要用户确认
AGENT_REQUIRE_CONFIRM_BEFORE_RENDER=true
# 缺字段最多让用户补充几轮
AGENT_MAX_FIELD_ASK_ROUNDS=2
# DOCX 渲染器：auto / docxtpl / python-docx
AGENT_DOCX_RENDERER=auto

# ---------- 目录与文件 ----------
AGENT_TEMPLATE_DIR=templates
AGENT_OUTPUT_DIR=outputs
AGENT_FILE_DIR=output/agent_files
AGENT_FILE_URL_PREFIX=/api/agent/files
AGENT_MAX_UPLOAD_MB=20

# item_name（主体名称）识别：送入大模型的上下文构造参数
# 是否启用大模型主体识别。false 时导入阶段不调用大模型、不写 kb_item_name 向量库，
# 直接用文件名兜底（经营晨报这类一文档多主体的资料建议关闭）
ITEM_NAME_RECOGNITION_ENABLED=false
# 上下文切片数：取前N个切片，避免上下文过长导致大模型输入超限
ITEM_NAME_CHUNK_K=5
# 单个切片内容截断长度：防止单切片内容过长，占满大模型上下文
ITEM_NAME_SINGLE_CHUNK_MAX_LEN=800
# 大模型上下文总字符数上限：适配主流大模型输入限制
ITEM_NAME_CONTEXT_TOTAL_MAX_CHARS=2500

# ---------- Langfuse 链路追踪（可选，不配则完全关闭）----------
# 未配置 PUBLIC/SECRET KEY 时 app/core/tracing.py 自动退化成 no-op，
# 业务行为、评测结果与接入前一致。密钥只放在 .env（已被 .gitignore 忽略）。
#
# 接入点：
#   线上问答   /query 与 /api/agent/chat 各一轮请求 = 一条 trace
#   消融评测   evaluation/run_eval.py、evaluation/ablation.py 一道道题 = 一条 trace
#   Agent 评测 evaluation/agent/run_agent_eval.py 一个个用例 = 一条 trace
#
# 自检（会真的联网调一次 Langfuse，确认密钥与网络都通）：
#   PYTHONPATH=. python -m app.core.tracing --check
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 区域端点：欧盟 https://cloud.langfuse.com；美国 https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# auto（默认）= 配了上面两个 KEY 就开启；true / false 强制开关
LANGFUSE_ENABLED=auto
# true（默认）上报 prompt / 答案原文；false 只上报结构、耗时、token 与指标。
# 金融场景若不允许数据出境，设成 false，或改用自建实例。
LANGFUSE_CAPTURE_CONTENT=true
# true（默认）对手机号 / 身份证号 / 16~19 位长数字做内置脱敏
LANGFUSE_MASK_ENABLED=true
# 可选：给 trace 打环境与版本标记（Langfuse SDK 直接读取）
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=local
