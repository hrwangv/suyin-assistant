# Session Memory V1（MySQL + Redis）
# 复制到 .env 并按实际环境修改

MYSQL_URL=mysql+pymysql://root:password@127.0.0.1:3306/suyin_memory?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Redis 最近消息缓存容量
MAX_CACHED_MESSAGES=200
# Redis 缓存 TTL，秒
CACHE_TTL_SECONDS=604800

# 每一轮读取多少条最近消息作为上下文（读取上限，与缓存容量无关）
CONTEXT_READ_LIMIT=50
# Query Analyzer 读取历史的 token 预算（超额丢最老的一条）
MAX_TOKEN_WINDOW_SIZE=8000
TOKENIZER_ENCODING=cl100k_base

# Agent Memory L2/L3
MEMORY_QDRANT_COLLECTION=agent_memory
ENTITY_QDRANT_COLLECTION=agent_entity

# 长期记忆归属的默认用户：长期记忆按用户聚合，跨对话共享。
# 留空且请求未带 user_id 时，长期记忆会退化为会话级（新对话读不到）。
MEMORY_DEFAULT_USER_ID=default-user

# 最近消息上下文缓存 TTL（秒）
REDIS_CONTEXT_TTL=86400
# 任务状态缓存 TTL（秒）
REDIS_TASK_TTL=7200
# 实体上下文缓存 TTL（秒）
REDIS_ENTITY_TTL=7200

# Redis 缓存里最多保留多少条最近消息（缓存容量）
CONTEXT_CACHE_CAPACITY=50
# MySQL 兜底表每个会话保留的最近消息条数（建议与上面一致，回源才无损）
CONTEXT_MYSQL_KEEP=50
# 长期记忆抽取时，提供给 LLM 的最近消息条数
EXTRACTION_CONTEXT_MESSAGES=10
# 长期记忆抽取时送给模型的历史上下文 token 预算（超额丢最老的一条）
EXTRACTION_CONTEXT_MAX_TOKENS=4000
# 抽取时作为去重参考的「已有记忆」token 预算（超额丢尾部，防自我放大）
EXTRACTION_EXISTING_MAX_TOKENS=2000

# ---------- 长期记忆抽取的触发控制 ----------
# 距上次抽取新增多少条消息才触发一次（必须小于 CONTEXT_MYSQL_KEEP，给异步执行留余量）
EXTRACT_TRIGGER_NEW_MESSAGES=40
# 最小批量：至少一问一答才值得抽
EXTRACT_MIN_BATCH=2
# 单次批处理上限
EXTRACT_BATCH_LIMIT=60
# 抽取水位的 TTL（秒），默认 7 天
EXTRACT_WATERMARK_TTL=604800

# 强度低于该值时归档
ARCHIVE_STRENGTH_THRESHOLD=0.1
# 强度低于该值但未归档时标记为 WEAK
WEAK_STRENGTH_THRESHOLD=0.3
# 访问次数增益系数
DECAY_ALPHA=0.1

# 实体检索相似度阈值
ENTITY_SEARCH_THRESHOLD=0.5
# 实体命中的最大加分（dense 相似度约 0.35~0.96，建议 0.2 与其同量级）
ENTITY_BOOST_MAX=0.5
# 实体语义去重阈值
ENTITY_DEDUP_THRESHOLD=0.95

# ---------- 召回候选数量 ----------
# 每一路（dense/sparse）预取的候选数
RETRIEVAL_PREFETCH_LIMIT=50
# 单次混合检索返回条数（主路 / HyDE 路各自拿到这么多）
RETRIEVAL_FUSED_LIMIT=20
# 主路 + HyDE 路合并后再融合，保留多少条进 rerank
RETRIEVAL_MERGE_TOP_K=20
# rerank 之后最多保留多少条进回答 prompt
RETRIEVAL_RERANK_MAX_TOPK=12

# ---------- 回答 prompt 的预算 ----------
# 输入总预算（token）。不用模型窗口当预算：真正的约束是成本、首字延迟和长上下文注意力衰减
ANSWER_INPUT_TOKEN_BUDGET=32000
# 给模型回答预留的输出空间（回答常带列表和表格，别留太少）
ANSWER_OUTPUT_RESERVE_TOKENS=3000
# 安全缓冲：吸收 tokenizer 差异（deepseek 与 cl100k 不完全一致）和模板变动
ANSWER_SAFETY_BUFFER_TOKENS=1500
# 长期记忆的检索条数（检索阶段就限住，后面还有总预算兜底）
ANSWER_LONG_TERM_MEMORY_TOP_K=5
# 长期记忆粗召回候选上限
SEMANTIC_INTERNAL_LIMIT=60
# 长期记忆最终返回条数默认值
DEFAULT_TOP_K=10

# 文档切分（document split）
# 单个Chunk最大字符长度（不是token）：超过则触发二次切分（适配大模型上下文窗口）
DOC_SPLIT_MAX_CONTENT_LENGTH=2000
# 短Chunk合并阈值：同父标题的短Chunk会被合并，减少碎片化
DOC_SPLIT_MIN_CONTENT_LENGTH=500

# item_name（主体名称）识别：送入大模型的上下文构造参数
# 是否启用大模型主体识别。false 时导入阶段不调用大模型、不写 kb_item_name 向量库，
# 直接用文件名兜底（经营晨报这类一文档多主体的资料建议关闭）
ITEM_NAME_RECOGNITION_ENABLED=false
# 上下文切片数：取前N个切片，避免上下文过长导致大模型输入超限
ITEM_NAME_CHUNK_K=5
# 单个切片内容截断长度：防止单切片内容过长，占满大模型上下文
ITEM_NAME_SINGLE_CHUNK_MAX_LEN=800
# 大模型上下文总字符数上限：适配主流大模型输入限制
ITEM_NAME_CONTEXT_TOTAL_MAX_CHARS=2500
