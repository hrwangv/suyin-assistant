    {"id": "q01", "request": "帮我看看这个文件", "state": {"document_type": "inquiry_letter", "candidate_addresses": ["江苏省南京市鼓楼区中山路1号"]}, "expected": "ask_user"},
    {"id": "q02", "request": "这个能用吗", "state": {"document_type": "generic_document"}, "expected": "ask_user"},
    {"id": "q03", "request": "看看", "state": {"document_type": "business_license"}, "expected": "ask_user"},
