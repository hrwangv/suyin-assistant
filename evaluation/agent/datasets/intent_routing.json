    {"id": "x01", "request": "帮我提取邮寄地址", "state": {"document_type": "inquiry_letter", "candidate_addresses": ["江苏省南京市鼓楼区中山路1号"]}, "expected": "answer", "expected_document_action": "extract_mailing_address"},
    {"id": "x02", "request": "回函地址是哪个？", "state": {"document_type": "inquiry_letter", "candidate_addresses": ["江苏省南京市鼓楼区中山路1号"]}, "expected": "answer", "expected_document_action": "extract_mailing_address"},
    {"id": "x03", "request": "帮我总结一下这份文件", "state": {"document_type": "inquiry_letter", "candidate_addresses": ["江苏省南京市鼓楼区中山路1号"]}, "expected": "answer", "expected_document_action": "summarize_document"},
    {"id": "x04", "request": "这份营业执照里公司叫什么？", "state": {"document_type": "business_license"}, "expected": "answer", "expected_document_action": "extract_company_info"},
